defmodule <%= @app_module %>.MixProject do
  use Mix.Project

  def project do
    [
      app: :<%= @app %>,
      version: "0.1.0",
      elixir: "~> 1.15",
      elixirc_paths: elixirc_paths(Mix.env()),
      start_permanent: Mix.env() == :prod,
      deps: deps()
    ]
  end

  def application do
    [
      extra_applications: [:logger],
      mod: {<%= @app_module %>.Application, []}
    ]
  end

  defp elixirc_paths(:test), do: ["lib", "test/support"]
  defp elixirc_paths(_), do: ["lib"]

  defp deps do
    [
<%= if @unpacked? do %>
      # The Lemon platform, from unpacked Hex tarballs (`mix hex.build --unpack`).
      # Those packages declare each other as Hex requirements; `override: true`
      # makes these paths win instead.
      {:lemon_core, path: "<%= @package_root %>/lemon_core", override: true},
      {:lemon_ai, path: "<%= @package_root %>/lemon_ai", override: true},
      {:lemon_agent, path: "<%= @package_root %>/lemon_agent", override: true},
<% else %>
      # The Lemon platform, as path dependencies on a lemon checkout. The Hex
      # line beneath each is the same package from a release; swap them to
      # build against Hex instead (0.2.0 is the first installable release).
      {:lemon_core, path: "<%= @package_root %>/lemon_core"},
      # {:lemon_core, "~> 0.2"},
      {:lemon_ai, path: "<%= @package_root %>/lemon_ai"},
      # {:lemon_ai, "~> 0.2"},
      {:lemon_agent, path: "<%= @package_root %>/lemon_agent"},
      # {:lemon_agent, "~> 0.2"},
<% end %>
<%= if @channel? do %>
      # The channel adapter in lib/<%= @app %>/channel.ex implements this
      # package's `LemonChannels.Plugin` behaviour. lemon_channels is not
      # published to Hex, so it always comes from the lemon checkout.
      {:lemon_channels, path: "<%= @package_root %>/lemon_channels"},
<% end %>
<%= if @memory? and @unpacked? do %>
      # Durable agent memory, backed by SQLite.
      {:lemon_memory, path: "<%= @package_root %>/lemon_memory", override: true},
<% end %>
<%= if @memory? and not @unpacked? do %>
      # Durable agent memory, backed by SQLite.
      {:lemon_memory, path: "<%= @package_root %>/lemon_memory"},
      # {:lemon_memory, "~> 0.2"},
<% end %>
<%= if @channel? do %>
      # The contract-test kit, which proves the channel adapter satisfies the
      # behaviour the platform relies on. Test-only.
      {:lemon_platform_test,
       path: "<%= @package_root %>/lemon_platform_test", only: :test, runtime: false},
      # {:lemon_platform_test, "~> 0.2", only: :test, runtime: false},
<% end %>
    ]
  end
end
