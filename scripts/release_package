#!/usr/bin/env bash
# release_package — verify, version, tag and publish ONE of the published Hex
# packages.
#
# Usage:
#   scripts/release_package <package> <version> [--dry-run | --verify | --publish-tagged] [--yes]
#   scripts/release_package --list
#
# Modes:
#   (default)         Check, set the version in mix.exs, roll the package's
#                     CHANGELOG [Unreleased] section into [<version>], commit,
#                     tag <package>-v<version>, then publish if HEX_API_KEY is set.
#   --dry-run         Run every check and change nothing.
#   --verify          Check an ALREADY-TAGGED release (CI on a tag push):
#                     mix.exs is at <version> and the changelog has [<version>].
#   --publish-tagged  Publish an already-tagged, already-verified release
#                     (the publish job in .github/workflows/publish.yml).
#   --yes             Skip the confirmation before mutating.
#
# Checks: the package is one of the published five (scripts/verify_packages
# --list); the version is valid semver and not behind mix.exs; the tag is free;
# the tree is clean; the changelog section has entries; every sibling Lemon
# package it depends on is already on hex.pm at its in-repo version; and
# scripts/verify_packages passes — the tarballs compile in a consumer project
# and the generator's projects pass their tests against them.
#
# Publishing happens from the unpacked tarball (`mix hex.build --unpack`), not
# from apps/<package>: what gets published, docs included, is exactly what
# verify_packages compiled. Hex has no multi-package release, so publish in the
# order --list prints; each package's siblings must be on hex.pm first.
#
# The umbrella itself stays on CalVer (scripts/bump_version.sh); this is only
# the per-package semver line. See docs/release/hex-packages.md.

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
VERIFY_PACKAGES="$REPO_ROOT/scripts/verify_packages"

MODE="release"
ASSUME_YES=0
PACKAGE=""
VERSION=""

die() {
  echo "ERROR: $*" >&2
  exit 1
}

ok() { echo "ok:   $*"; }

usage() {
  sed -n '2,/^set -euo/p' "${BASH_SOURCE[0]}" | sed '$d' | sed 's/^# \{0,1\}//'
  exit "${1:-64}"
}

published_packages() { "$VERIFY_PACKAGES" --list; }

is_published() {
  published_packages | grep -qx "$1"
}

current_version() {
  sed -n 's/^[[:space:]]*@version[[:space:]]*"\([^"]*\)".*/\1/p' "$REPO_ROOT/apps/$1/mix.exs" | head -1
}

# Sibling Lemon packages this package declares (runtime or optional).
sibling_deps() {
  local dep
  for dep in $(grep -oE '\{:lemon_[a-z_]+, in_umbrella: true' "$REPO_ROOT/apps/$1/mix.exs" |
    sed -E 's/^\{:([a-z_]+),.*/\1/'); do
    if is_published "$dep"; then echo "$dep"; fi
  done
}

semver_valid() {
  echo "$1" | grep -qE '^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?$'
}

version_gt() {
  [ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -1)" = "$1" ]
}

# 0 when <package> <version> exists on hex.pm, 1 when it does not.
on_hex() {
  local code
  code="$(curl -sS -o /dev/null -w '%{http_code}' --max-time 15 \
    "https://hex.pm/api/packages/$1/releases/$2")" || die "could not reach hex.pm"
  case "$code" in
    200) return 0 ;;
    404) return 1 ;;
    *) die "hex.pm answered HTTP $code for $1 $2" ;;
  esac
}

changelog_has_entries() {
  python3 - "$1" "$2" <<'EOF'
import re, sys

text = open(sys.argv[1], encoding="utf-8").read()
section = re.escape(sys.argv[2])
match = re.search(r"^##\s*\[" + section + r"\][^\n]*$(.*?)(?=^##\s|\Z)", text, re.M | re.S)
sys.exit(0 if match and re.search(r"^\s*[-*]\s+\S", match.group(1), re.M) else 1)
EOF
}

publish_from_tarball() {
  [ -n "${HEX_API_KEY:-}" ] || die "HEX_API_KEY is not set"
  local work
  work="$(mktemp -d "${TMPDIR:-/tmp}/lemon_publish.XXXXXX")"
  (cd "$REPO_ROOT/apps/$PACKAGE" &&
    LEMON_HEX_PUBLISH=1 mix hex.build --unpack --output "$work/$PACKAGE")
  (cd "$work/$PACKAGE" && mix deps.get && mix hex.publish --yes)
  rm -rf "$work"
  ok "published $PACKAGE $VERSION to hex.pm (package + docs)"
}

# ── Arguments ────────────────────────────────────────────────────────────────

[ "$#" -eq 0 ] && usage

while [ "$#" -gt 0 ]; do
  case "$1" in
    -h | --help) usage 0 ;;
    --list) published_packages; exit 0 ;;
    --dry-run) MODE="dry-run" ;;
    --verify) MODE="verify" ;;
    --publish-tagged) MODE="publish-tagged" ;;
    --yes) ASSUME_YES=1 ;;
    -*) die "unknown option: $1 (try --help)" ;;
    *)
      if [ -z "$PACKAGE" ]; then
        PACKAGE="$1"
      elif [ -z "$VERSION" ]; then
        VERSION="$1"
      else
        die "unexpected argument: $1"
      fi
      ;;
  esac
  shift
done

[ -n "$PACKAGE" ] || die "missing <package> (try --list)"
[ -n "$VERSION" ] || die "missing <version>"
cd "$REPO_ROOT"

echo "── release_package: $PACKAGE $VERSION [$MODE] ──"

is_published "$PACKAGE" ||
  die "'$PACKAGE' is not a published package; the published set is: $(published_packages | tr '\n' ' ')"
semver_valid "$VERSION" || die "'$VERSION' is not valid semver (X.Y.Z[-pre])"

TAG="${PACKAGE}-v${VERSION}"
CURRENT="$(current_version "$PACKAGE")"
[ -n "$CURRENT" ] || die "could not read @version from apps/$PACKAGE/mix.exs"

if [ "$MODE" = "publish-tagged" ]; then
  [ "$VERSION" = "$CURRENT" ] || die "tag says $VERSION but apps/$PACKAGE/mix.exs says $CURRENT"
  publish_from_tarball
  exit 0
fi

# ── Version, tag, tree ───────────────────────────────────────────────────────

if [ "$MODE" = "verify" ] || [ "$VERSION" = "$CURRENT" ]; then
  [ "$VERSION" = "$CURRENT" ] || die "tag says $VERSION but apps/$PACKAGE/mix.exs says $CURRENT"
  ok "apps/$PACKAGE/mix.exs is at $VERSION"
elif version_gt "$VERSION" "$CURRENT"; then
  ok "$VERSION is ahead of mix.exs ($CURRENT); a release bumps it"
else
  die "$VERSION is behind apps/$PACKAGE/mix.exs ($CURRENT)"
fi

if [ "$MODE" != "verify" ]; then
  ! git rev-parse -q --verify "refs/tags/$TAG" >/dev/null || die "tag $TAG already exists"
  ok "tag $TAG is free"
fi

if [ -n "$(git status --porcelain)" ]; then
  [ "$MODE" = "release" ] && die "working tree is dirty; commit or stash first"
  echo "warn: working tree is dirty (a real release refuses)" >&2
else
  ok "working tree is clean"
fi

# ── Changelog ────────────────────────────────────────────────────────────────

CHANGELOG="apps/$PACKAGE/CHANGELOG.md"
SECTION="Unreleased"
[ "$MODE" = "verify" ] && SECTION="$VERSION"
changelog_has_entries "$CHANGELOG" "$SECTION" ||
  die "$CHANGELOG needs a '## [$SECTION]' section with at least one entry"
ok "$CHANGELOG has entries under [$SECTION]"

# ── Publish order ────────────────────────────────────────────────────────────

for dep in $(sibling_deps "$PACKAGE"); do
  dep_version="$(current_version "$dep")"
  on_hex "$dep" "$dep_version" ||
    die "$dep $dep_version is not on hex.pm yet; publish it before $PACKAGE"
  ok "$dep $dep_version is on hex.pm"
done

# ── Tarball consumer check ───────────────────────────────────────────────────

"$VERIFY_PACKAGES"
ok "scripts/verify_packages passed"

if [ "$MODE" != "release" ]; then
  echo
  echo "── $MODE complete: $PACKAGE $VERSION is releasable ──"
  exit 0
fi

# ── Release ──────────────────────────────────────────────────────────────────

if [ "$ASSUME_YES" -eq 0 ]; then
  printf 'Release %s %s and tag it %s? [y/N] ' "$PACKAGE" "$VERSION" "$TAG"
  read -r reply
  case "$reply" in
    y | Y | yes | YES) ;;
    *) die "aborted" ;;
  esac
fi

if [ "$VERSION" != "$CURRENT" ]; then
  sed -i.bak "s/@version \"${CURRENT}\"/@version \"${VERSION}\"/" "apps/$PACKAGE/mix.exs"
  rm -f "apps/$PACKAGE/mix.exs.bak"
  [ "$(current_version "$PACKAGE")" = "$VERSION" ] || die "version bump did not take effect"
  ok "apps/$PACKAGE/mix.exs is now $VERSION"
fi

python3 - "$CHANGELOG" "$VERSION" <<'EOF'
import sys
from datetime import date

path, version = sys.argv[1], sys.argv[2]
text = open(path, encoding="utf-8").read()
heading = "## [Unreleased]"
index = text.index(heading)
rolled = f"{heading}\n\n_No unreleased changes._\n\n## [{version}] - {date.today().isoformat()}"
open(path, "w", encoding="utf-8").write(text[:index] + rolled + text[index + len(heading):])
EOF
ok "rolled $CHANGELOG into [$VERSION]"

git add "apps/$PACKAGE/mix.exs" "$CHANGELOG"
git commit -m "release($PACKAGE): v$VERSION"
git tag -a "$TAG" -m "$PACKAGE v$VERSION"
ok "committed and tagged $TAG"

if [ -n "${HEX_API_KEY:-}" ]; then
  publish_from_tarball
else
  echo "HEX_API_KEY is not set, so nothing was published. Push the tag and let"
  echo "publish.yml publish it, or run: HEX_API_KEY=... scripts/release_package $PACKAGE $VERSION --publish-tagged"
fi

echo
echo "Push with: git push origin HEAD && git push origin $TAG"
